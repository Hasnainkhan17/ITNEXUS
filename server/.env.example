# MongoDB connection string (required)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/dbname"

# JWT secret for admin authentication (required)
JWT_SECRET="your_jwt_secret_here"

# Frontend URL for CORS (set to your domain in production)
FRONTEND_URL="https://itnexus.org"

# Server port (Hostinger may set this automatically)
PORT=5000

# SMTP Email Configuration (Required for 2FA / OTP Password Reset)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE="false" # set to "true" for port 465, "false" for port 587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password" # App-specific password if using Gmail
EMAIL_FROM='"ITNEXUS Console Auth" <your-email@gmail.com>'
